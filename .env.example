# Server-side only — never prefix these with NEXT_PUBLIC_
# Copy to .env and fill with real values. Do not commit .env.

# App auth (server-only)
APP_USERNAME=
# Prefer APP_PASSWORD_HASH in production. Plain APP_PASSWORD is supported for local/shared login.
APP_PASSWORD=
# Optional scrypt hash: scrypt$N$r$p$saltHex$hashHex (use hashPassword() from src/lib/auth/password.ts)
# APP_PASSWORD_HASH=
SESSION_SECRET=

# Google Drive service account (server-only)
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional: full service account JSON instead of email + private key
# GOOGLE_SERVICE_ACCOUNT_KEY=

# Optional app URL (server-only)
APP_URL=
